# Default deny. Only public source roots and explicitly approved files are admitted.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/CHANGELOG.md
!/CONTRIBUTING.md
!/SECURITY.md
!/AGENTS.md
!/PaperFlow/
!/Launcher/
!/tests/
!/scripts/
!/docs/
!/.github/
!/.githooks/
**/bin/
**/obj/
**/data/
**/private/
**/artifacts/
**/backups/
**/journal/
**/events-v1/
**/app-cache/
**/local-settings*
**/papers*.json
**/device-id.txt
**/*.user
**/*.lnk
**/*.log
**/*.pdb
**/*.exe
**/*.zip
**/*.tmp
**/*.local.*
**/.env*
